<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Lets each developer keep secrets out of the repository (dotnet user-secrets set Jwt:SigningKey ...).
    In Development they override appsettings.Development.json; elsewhere use environment variables
    or a vault.
  -->
  <PropertyGroup>
    <UserSecretsId>cqrs-api-example-8c1f4b2e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Design-time only (dotnet ef); the API is the startup project for migrations. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CqrsApiExample.Api.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\CqrsApiExample.Application.csproj" />
    <ProjectReference Include="..\Contracts\CqrsApiExample.Contracts.csproj" />
    <ProjectReference Include="..\Infrastructure\CqrsApiExample.Infrastructure.csproj" />
  </ItemGroup>

</Project>
