{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Persistence": {
    "Provider": "ADO"
  },
  "Jwt": {
    "Issuer": "CqrsApiExample",
    "Audience": "CqrsApiExample.Api",
    "AccessTokenLifetime": "00:30:00"
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 300,
      "Window": "00:01:00"
    },
    "Authentication": {
      "PermitLimit": 10,
      "Window": "00:01:00"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
